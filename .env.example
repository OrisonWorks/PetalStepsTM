# Optional OCR-assisted physical receipt review. OCR output is never authoritative.
HUGGINGFACE_TOKEN=
HUGGINGFACE_OCR_MODEL=naver-clova-ix/donut-base-finetuned-cord-v2
HUGGINGFACE_OCR_URL=
# Google Sheets datasource (published CSV URL). Leave empty to use the built-in catalogue in src/lib/products.ts
# In Google Sheets: File > Share > Publish to web > select the Products sheet > Comma-separated values (.csv) > Publish
# Paste the generated URL here locally (.env.local) and in Vercel > Project > Settings > Environment Variables
PRODUCTS_SHEET_CSV_URL=

# Stock admin page (/admin) — lets you mark sizes sold/restocked from the site.
# Passcode for signing in at /admin (choose anything long; required to enable /admin)
ADMIN_PASSCODE=
# Write path to the sheet: deploy scripts/stock_writer.gs as a Google Apps Script web app
# on your spreadsheet (see README "Stock admin"), then paste its /exec URL here.
STOCK_WRITER_URL=
# Shared secret — must match the STOCK_TOKEN Script Property in Apps Script
STOCK_WRITER_TOKEN=

# WhatsApp Cloud API (optional — everything works without it; admin follow-ups
# fall back to wa.me links). Set all three once the WABA is verified:
# WHATSAPP_TOKEN: permanent system-user token from Meta for Developers
WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: the number's ID shown in Meta > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN: any random string you invent; paste the same value in
# Meta's webhook config pointing at https://<site>/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
